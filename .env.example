POSTGRES_DB=lawchat
POSTGRES_USER=lawchat
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lawchat:change-me@localhost:5432/lawchat

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO_SQL=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=legal_chunks_bge_m3_1024_v1
QDRANT_ALIAS=legal_chunks_current
QDRANT_PREFER_GRPC=false
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_LENGTH=1200
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_PATH=./data/.cache/huggingface
EMBEDDING_LOCAL_FILES_ONLY=false

BM25_INDEX_ROOT=./data/indexes/bm25
BM25_INDEX_NAME=legal_bm25_v1
BM25_INDEX_ALIAS=legal_bm25_current
BM25_WRITER_HEAP_SIZE=256000000
BM25_WRITER_THREADS=2

RRF_K=60
RRF_DENSE_WEIGHT=2.0
RRF_SPARSE_WEIGHT=1.0

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES=8
RERANKER_BATCH_SIZE=1
RERANKER_MAX_LENGTH=1536
RERANKER_DEVICE=cpu
RERANKER_CACHE_PATH=./data/.cache/huggingface
RERANKER_LOCAL_FILES_ONLY=true

LAWCHAT_LLM_BASE_URL=http://127.0.0.1:11434/v1
LAWCHAT_LLM_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
LAWCHAT_LLM_API_KEY=ollama
LAWCHAT_LLM_MODEL=gemma4:31b-cloud
LAWCHAT_LLM_TIMEOUT_SECONDS=180
LAWCHAT_LLM_CONTEXT_WINDOW=16384
LAWCHAT_LLM_SYSTEM_PROMPT_TOKENS=2000
LAWCHAT_LLM_ANSWER_RESERVE_TOKENS=4096
LAWCHAT_CONTEXT_MAX_EVIDENCE_TOTAL=12
LAWCHAT_CONTEXT_MAX_EVIDENCE_PER_ISSUE=3
LAWCHAT_CONTEXT_MAX_GRAPH_EVIDENCE=2
LAWCHAT_LLM_MAX_TOKENS=4096
LAWCHAT_LLM_REASONING_EFFORT=none
LAWCHAT_LLM_WARMUP_ENABLED=false
LAWCHAT_RAG_MAX_CONCURRENCY=1
LAWCHAT_RAG_MAX_QUEUE=4
LAWCHAT_RAG_QUEUE_TIMEOUT_SECONDS=10
LAWCHAT_RAG_REQUEST_TIMEOUT_SECONDS=300
LAWCHAT_JSON_LOGS=true
LAWCHAT_LOG_LEVEL=INFO
LAWCHAT_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LAWCHAT_API_BASE_URL=http://127.0.0.1:8000
LAWCHAT_PUBLIC_BASE_URL=http://localhost:8501
LAWCHAT_PUBLIC_API_BASE_URL=http://localhost:8000
LAWCHAT_WORKSPACE_ID=local
LAWCHAT_SOURCE_MCP_URL=
LAWCHAT_SOURCE_MCP_TOOL=google_search
LAWCHAT_SOURCE_MCP_API_KEY=
LAWCHAT_SOURCE_MCP_TIMEOUT_SECONDS=20
LAWCHAT_SOURCE_CACHE_DAYS=30
LAWCHAT_SOURCE_OFFICIAL_DOMAINS=vbpl.vn,congbao.chinhphu.vn,vanban.chinhphu.vn,moj.gov.vn
LAWCHAT_LEGAL_CUTOFF_DATE=2026-07-31
LAWCHAT_ISSUE_MAX_TOKENS=1024
LAWCHAT_ISSUE_TIMEOUT_SECONDS=60
# LLM rewrite of every question into a standalone retrieval query (uses chat history).
LAWCHAT_QUERY_REWRITE_ENABLED=true
LAWCHAT_REWRITE_MAX_TOKENS=256
LAWCHAT_REWRITE_TIMEOUT_SECONDS=20

# Claim entailment: shadow records findings; enforce can reject/repair answers.
LAWCHAT_LLM_RESPONSE_FORMAT=json_object
LAWCHAT_LLM_ALLOW_FENCED_JSON=true
LAWCHAT_SEMANTIC_MODE=enforce
LAWCHAT_SEMANTIC_MODEL=gemma4:31b-cloud
LAWCHAT_SEMANTIC_SHADOW_MODEL=
LAWCHAT_SEMANTIC_MAX_TOKENS=3072
LAWCHAT_SEMANTIC_TIMEOUT_SECONDS=60
LAWCHAT_SEMANTIC_CACHE_MAX_ENTRIES=256
LAWCHAT_SEMANTIC_CACHE_TTL_SECONDS=300
LAWCHAT_EVIDENCE_VERSION=unversioned
