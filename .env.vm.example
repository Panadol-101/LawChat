POSTGRES_DB=lawchat
POSTGRES_USER=lawchat
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lawchat:change-me@localhost:5432/lawchat

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=legal_chunks_bge_m3_1024_v1
QDRANT_ALIAS=legal_chunks_current
HISTORICAL_INDEX_ENABLED=false
HISTORICAL_QDRANT_COLLECTION=legal_chunks_historical_bge_m3_1024_v1
HISTORICAL_QDRANT_ALIAS=legal_chunks_historical
QDRANT_PREFER_GRPC=true

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_LENGTH=1200
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cuda
EMBEDDING_CACHE_PATH=./data/.cache/huggingface
EMBEDDING_LOCAL_FILES_ONLY=false

BM25_INDEX_ROOT=./data/indexes/bm25
BM25_INDEX_NAME=legal_bm25_bge_m3_v1
BM25_INDEX_ALIAS=legal_bm25_current
HISTORICAL_BM25_INDEX_NAME=legal_bm25_historical_v1
HISTORICAL_BM25_ALIAS=legal_bm25_historical
BM25_WRITER_HEAP_SIZE=256000000
BM25_WRITER_THREADS=2

RRF_K=60
RRF_DENSE_WEIGHT=2.0
RRF_SPARSE_WEIGHT=1.0

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_CANDIDATES=8
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=1536
RERANKER_CACHE_PATH=./data/.cache/huggingface
RERANKER_LOCAL_FILES_ONLY=false
